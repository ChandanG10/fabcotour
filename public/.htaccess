# Fabpodd frontend (Apache/cPanel)
# CORS is intentionally not configured here. The API owns the single
# credentialed CORS policy and the frontend calls it directly.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never turn a missing API request into the frontend HTML document.
  RewriteCond %{REQUEST_URI} ^/api(?:/|$) [NC]
  RewriteRule ^ - [L]

  # Serve real assets and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router history fallback, including /admin/* routes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Ensure new deployments are discovered while hashed assets stay cacheable.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
