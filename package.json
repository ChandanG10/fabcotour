{
  "name": "fab-couture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/index.js",
    "migrate": "tsx server/scripts/migrate.ts",
    "seed:customisation": "tsx server/scripts/seed-customisation.ts",
    "generate:customisation-placeholders": "node scripts/generate-customisation-placeholders.mjs",
    "seed:admin": "tsx server/scripts/seed-admin.ts",
    "reset:admin-password": "tsx server/scripts/reset-admin-password.ts",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.18",
    "@fontsource/manrope": "^5.0.18",
    "@hookform/resolvers": "^3.9.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fabric": "^7.4.0",
    "framer-motion": "^11.3.19",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-rnd": "^10.4.12",
    "react-router-dom": "^7.18.2",
    "sonner": "^1.5.0",
    "three": "^0.170.0",
    "uuid": "^14.0.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
